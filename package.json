{
  "name": "@drenso/homey-zigbee-library",
  "version": "0.0.0",
  "description": "A collection of helpers for initializing zigbee Homey capabilities without all the boilerplate",
  "author": "Drenso <hallo@drenso.nl>",
  "contributors": [
    "Bob van de Vijver <bob@drenso.nl>",
    "Tobias Feijten <tobias@drenso.nl>",
    "Joost Loohuis <joost@loohuis.dev>"
  ],
  "type": "module",
  "devDependencies": {
    "@drenso/eslint-config-homey-mts": "1.2.0",
    "@drenso/prettier-config-homey-mts": "1.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^24.12.2",
    "@types/source-map-support": "^0.5.10",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.5",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "scripts": {
    "compile": "tsc",
    "clean": "tsc --build --clean",
    "lint": "eslint",
    "fix": "eslint --fix",
    "prettier": "prettier . --write",
    "prettier-check": "prettier . --check",
    "prepare": "tsc"
  },
  "peerDependencies": {
    "homey-zigbeedriver": "^2.2.17",
    "zigbee-clusters": "^3.1.3"
  },
  "sideeffects": false,
